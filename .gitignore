# AI Ops Log Analyzer — Git ignore rules

# Secrets & environment
# Never commit real environment files or credentials. Keep .env.example only.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
secrets.*
*.secret
credentials.json

# Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing & coverage
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# IDE / editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
