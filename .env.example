# AI Ops Log Analyzer - example environment configuration
# Copy to .env and replace placeholders. Never commit .env.

# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=ai_ops
DB_USER=ai_ops_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Backend -> LiteLLM shared secret
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=

# AI providers
# Priority when multiple are enabled: Azure AI Foundry > Google Gemini > Ollama
OLLAMA_PROVIDER_ENABLE=true
AZURE_FOUNDRY_PROVIDER_ENABLE=false
GOOGLE_GEMINI_PROVIDER_ENABLE=false

# Azure AI Foundry via Microsoft Entra Service Principal.
# Required only when AZURE_FOUNDRY_PROVIDER_ENABLE=true.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_API_BASE=
AZURE_API_VERSION=2024-10-21
AZURE_MODEL=gpt-4o-mini
AZURE_SCOPE=https://cognitiveservices.azure.com/.default

# Google Gemini via Google AI Studio API key.
# Required only when GOOGLE_GEMINI_PROVIDER_ENABLE=true.
# Get your API key at: https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama
OLLAMA_API_BASE=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# RAG
SIMILARITY_SEARCH_MODE=keyword
RAG_TOP_N=3
RAG_CONTEXT_MAX_CHARS=4000

# Timeouts
LLM_TIMEOUT_SECONDS=200
DB_QUERY_TIMEOUT_SECONDS=5

# Application
APP_ENV=production

# Jenkins
BACKEND_URL=http://backend:8000
# Set to false to disable ANSI colors in Jenkins console (requires AnsiColor plugin when true)
ANSI_CONSOLE=true

# Notifications — handled by the backend, not the Jenkins pipeline.
# Webhook secrets stay on the backend server only and are never sent to Jenkins.
# Set TEAMS_NOTIFY_ENABLE=true to send Teams notifications, then fill TEAMS_WEBHOOK_URL.
TEAMS_NOTIFY_ENABLE=false
TEAMS_WEBHOOK_URL=

# Set SLACK_NOTIFY_ENABLE=true to send Slack notifications, then fill SLACK_WEBHOOK_URL.
SLACK_NOTIFY_ENABLE=false
SLACK_WEBHOOK_URL=